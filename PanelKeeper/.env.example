# PanelKeeper - Environment

PORT=7001

# Database and application log
DB_PATH=./data/panelkeeper.db
QC_DB_PATH=./data/panelkeeper_qc.db
LOG_PATH=./data/manager_history.log

# Initial paths (optional, can be changed in the app settings)
# Used when initializing a new database. Existing saved Settings take precedence.
MANGA_SOURCE_ROOT=./downloads
MANGA_DESTINATION=./manga
