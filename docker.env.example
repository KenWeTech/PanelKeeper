# PanelKeeper - Docker environment
# Copy to .env before starting: cp docker.env.example .env

PORT=7001

# Database and application log
DB_PATH=/app/data/panelkeeper.db
QC_DB_PATH=/app/data/panelkeeper_qc.db
LOG_PATH=/app/data/manager_history.log

# Initial manga paths (must match docker-compose.yml volume destinations)
MANGA_SOURCE_ROOT=/downloads
MANGA_DESTINATION=/manga
